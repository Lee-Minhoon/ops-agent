{
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "summary", "comments"],
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["APPROVE", "REQUEST_CHANGES", "COMMENT"]
    },
    "summary": {
      "type": "string"
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "line", "body"],
        "properties": {
          "path": { "type": "string" },
          "line": { "type": "integer" },
          "body": { "type": "string" }
        }
      }
    }
  }
}
